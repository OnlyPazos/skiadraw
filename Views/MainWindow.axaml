<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:skiadraw.ViewModels"
        xmlns:v="clr-namespace:skiadraw.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="360"
        x:Class="skiadraw.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="skiadraw">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="*" RowDefinitions="64,*">
        <v:Toolbar Grid.Row="0" ZIndex="20" DataContext="{Binding Toolbar}"></v:Toolbar>
        <v:DebugPanel Grid.Row="0" Grid.RowSpan="2" Margin="0,10,10,0" ZIndex="10" DataContext="{Binding Debug}"></v:DebugPanel>
        <v:Canvas Grid.Row="0" Grid.RowSpan="2" DataContext="{Binding Canvas}"></v:Canvas>
        <StackPanel Grid.Row="0" Grid.RowSpan="2"
                    Orientation="Horizontal"
                    Margin="10,0,0,10"
                    Spacing="{DynamicResource Space3}"
                    VerticalAlignment="Bottom">
            <v:Zoom></v:Zoom>
            <v:UndoRedo></v:UndoRedo>
        </StackPanel>
    </Grid>
</Window>